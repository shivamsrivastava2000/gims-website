*.env
!client/.env.production
!.env.example
!server/.env.example

# --- Build and dist outputs ---
build/
dist/
client/build/
client/dist/
server/build/
server/dist/

# --- Firebase & temporary files ---
.firebase/
.firebaserc

# --- OS / Editor files ---
.DS_Store
Thumbs.db
.vscode/

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Misc ---
uploads/
